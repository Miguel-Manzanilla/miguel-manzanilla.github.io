---
interface Props {
  title?: string
  body?: string
}

const { title, body } = Astro.props
---

<>
  {
    /*
    El `pr-8` deja hueco a la flecha que dibuja Card.astro en la esquina
    superior derecha de las tarjetas que son enlace.
  */
  }
  {title && <h2 class="z-20 m-0 pr-8 text-xl font-bold">{title}</h2>}
  {body && <p class="m-0 text-base font-light">{body}</p>}
  <slot />
</>
