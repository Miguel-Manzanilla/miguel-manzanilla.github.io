---
import { Card as ShadcnCard } from './ui/card'

/**
 * Tarjeta de proyecto usada en /portfolio.
 *
 * `heading` y `subheading` son <h3> porque la pagina ya tiene un <h1>: antes
 * eran <h1>/<h2>, lo que generaba varios h1 por pagina.
 */
interface Props {
  href: string
  heading: string
  subheading?: string
  altText?: string
  imagePath?: string
}

const { href, heading, subheading, altText, imagePath } = Astro.props
---

<ShadcnCard
  class="group relative flex h-full flex-col overflow-hidden text-start shadow-lg transition duration-300 ease-in-out hover:border-primary"
>
  {
    imagePath && (
      <img
        src={imagePath}
        alt={altText ?? ''}
        class="h-48 w-full rounded-2xl object-cover"
        loading="lazy"
        decoding="async"
      />
    )
  }

  <a
    href={href}
    target="_blank"
    rel="noreferrer noopener"
    class="flex h-full flex-col gap-y-0.5 p-5"
  >
    <h3 class="text-lg font-medium transition-colors group-hover:text-primary">
      {heading}
    </h3>
    {subheading && <p class="text-sm text-muted-foreground">{subheading}</p>}
    <slot />
  </a>
</ShadcnCard>
