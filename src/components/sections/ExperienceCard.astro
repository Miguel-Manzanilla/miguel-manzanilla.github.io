---
import Card from '../Card.astro'
import { buttonVariants } from '../ui/button'
import { EXPERIENCE } from '../../lib/cv'

/** Muestra los 3 puestos más recientes; el resto está en /work. */
const RECENT = EXPERIENCE.slice(0, 3)
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2" title="Experiencia">
  <div class="mt-2 flex h-full flex-col">
    <ol class="flex flex-col gap-4">
      {
        RECENT.map((exp) => (
          <li>
            <h3 class="text-sm font-semibold">{exp.position}</h3>
            <a
              class="text-sm text-primary underline underline-offset-2"
              href={exp.link}
              target="_blank"
              rel="noreferrer noopener"
            >
              {exp.company}
            </a>
            <p class="text-xs text-muted-foreground">
              <time>
                {exp.start} — {exp.end}
              </time>
            </p>
          </li>
        ))
      }
    </ol>

    <a
      href="/work"
      class={buttonVariants({
        variant: 'link',
        className: 'mt-auto w-fit p-0',
      })}
    >
      Ver más
    </a>
  </div>
</Card>
