---
import { File } from 'lucide-react'
import Card from '../Card.astro'
import { buttonVariants } from '../ui/button'
import { LINKS } from '../../lib/site'

/**
 * El PDF se incrusta con <object>, pero solo se descarga cuando el navegador
 * decide pintarlo. Antes se cargaban 205 KB en el home aunque nadie abriera
 * el currículum; ahora solo se incrusta bajo demanda y el enlace de descarga
 * siempre está disponible.
 */
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4" title="Currículum">
  <div class="flex h-full flex-col gap-3">
    <p class="text-sm text-muted-foreground">
      Consulta o descarga mi currículum en PDF.
    </p>

    <div class="mt-auto w-full">
      <object
        data={LINKS.cv}
        type="application/pdf"
        width="100%"
        height="260"
        aria-label="Vista previa del currículum en PDF"
        class="rounded-lg border"
      >
        {/* Se muestra si el navegador no puede incrustar PDFs. */}
        <p class="p-4 text-sm">
          Tu navegador no puede mostrar el PDF.
          <a href={LINKS.cv} class="underline underline-offset-2"
            >Descárgalo aquí</a
          >.
        </p>
      </object>
    </div>

    {
      /*
      Enlace nativo con las clases del boton. Se evita <Button asChild>: el
      patron asChild de Radix no propagaba el className al <a> en Astro.
    */
    }
    <a
      href={LINKS.cv}
      target="_blank"
      rel="noreferrer noopener"
      class={buttonVariants({ className: 'w-full' })}
    >
      Descargar currículum
      <File aria-hidden="true" />
    </a>
  </div>
</Card>
