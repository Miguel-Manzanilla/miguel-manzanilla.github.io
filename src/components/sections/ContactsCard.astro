---
import Card from '../Card.astro'
import { LINKS, SITE } from '../../lib/site'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="flex h-full flex-col">
    <h2 class="text-xl font-bold text-foreground">¡Hablemos!</h2>

    <address class="mt-3 flex flex-col not-italic">
      <h3 class="text-sm text-muted-foreground">Contacto</h3>
      <ul class="mt-1 flex flex-col gap-1 text-sm">
        <li>
          <a
            href={LINKS.mail}
            class="underline underline-offset-2 hover:text-primary"
            >{SITE.EMAIL}</a
          >
        </li>
        <li>
          <a
            href="tel:+34608779059"
            class="underline underline-offset-2 hover:text-primary"
            >608 77 90 59</a
          >
        </li>
        <li>🇪🇸 Toledo, España 🇪🇸</li>
      </ul>
    </address>

    <div class="mt-4 flex flex-col">
      <h3 class="text-sm text-muted-foreground">Redes sociales</h3>
      <ul class="mt-1 flex flex-col gap-1 text-sm">
        <li>
          <a
            href={LINKS.linkedin}
            target="_blank"
            rel="noreferrer noopener"
            class="underline underline-offset-2 hover:text-primary">LinkedIn</a
          >
        </li>
        <li>
          <a
            href={LINKS.github}
            target="_blank"
            rel="noreferrer noopener"
            class="underline underline-offset-2 hover:text-primary">GitHub</a
          >
        </li>
      </ul>
    </div>
  </div>
</Card>
