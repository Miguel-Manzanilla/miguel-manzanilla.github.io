---
import Card from '../Card.astro'
import { Badge } from '../ui/badge'
import { STUDIES } from '../../lib/cv'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" title="Estudios">
  <ul class="mt-2 flex w-full flex-wrap items-center justify-center gap-2">
    {
      STUDIES.map((study) => (
        <li>
          {study.link ? (
            <a
              href={study.link}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full"
            >
              <Badge variant="outline">{study.institution}</Badge>
            </a>
          ) : (
            // Sin web pública que enlazar: se muestra como texto, no como
            // enlace roto. Antes todos apuntaban a 'ejemplo.com'.
            <Badge variant="outline">{study.institution}</Badge>
          )}
        </li>
      ))
    }
  </ul>
</Card>
