---
import Card from '../Card.astro'
import { buttonVariants } from '../ui/button'
import { PROJECTS } from '../../lib/cv'

/** Los 5 más destacados en el home; la lista completa vive en /portfolio. */
const FEATURED = PROJECTS.slice(0, 5)
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2" title="Mis Proyectos">
  <div class="flex h-full flex-col">
    <p class="mt-2 text-sm text-muted-foreground">
      Algunos de mis proyectos más destacados.
    </p>
    <ul class="mt-3 flex flex-col gap-2">
      {
        FEATURED.map((project) => (
          <li>
            <a
              href={project.link}
              target="_blank"
              rel="noreferrer noopener"
              title={project.description}
              class={buttonVariants({
                variant: 'outline',
                className: 'w-full justify-start',
              })}
            >
              {project.title}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/portfolio"
      class={buttonVariants({
        variant: 'link',
        className: 'mt-auto w-fit p-0',
      })}
    >
      Ver todos los proyectos
    </a>
  </div>
</Card>
