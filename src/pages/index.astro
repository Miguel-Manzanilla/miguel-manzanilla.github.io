---
import BaseLayout from '../layouts/BaseLayout.astro'
import IntroCard from '../components/sections/IntroCard.astro'
import AboutMe from '../components/sections/AboutMe.astro'
import Card from '../components/Card.astro'
import TimeZoneCard from '../components/sections/TimeZoneCard.astro'
import ContactsCard from '../components/sections/ContactsCard.astro'
import Now from '../components/sections/Now.astro'
import CVCard from '../components/sections/CVCard.astro'
import ExperienceCard from '../components/sections/ExperienceCard.astro'
import ProjectsCard from '../components/sections/ProjectsCard.astro'
import StudyCard from '../components/sections/StudyCard.astro'
import { SITE } from '../lib/site'
---

{
  /*
  Nota sobre animaciones: la entrada de las tarjetas la hace CSS
  (`.card-animate` en globals.css) en lugar de JavaScript. Antes se usaba la
  libreria `motion` desde un `<script>` para animar un loader a pantalla
  completa, lo que retrasaba el primer render y dejaba la pagina en gris si el
  script no llegaba a ejecutarse. Con CSS el contenido se ve siempre.
*/
}

<BaseLayout title={SITE.TITLE} description={SITE.DESCRIPTION}>
  <main
    class="relative m-auto grid w-full max-w-6xl gap-2 p-2 sm:gap-2 sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-cols-4 lg:grid-rows-8 lg:gap-4"
  >
    <IntroCard />
    <AboutMe />
    <CVCard />
    <Now />
    <Card
      colSpan="md:col-span-1"
      rowSpan="md:row-span-2"
      title="Portafolio y Proyectos"
      body="Juegos, apps Android, escritorio y scripts. Todo el código es público."
      href="/portfolio"
    />
    <TimeZoneCard />
    <ContactsCard />
    <ExperienceCard />
    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <div class="flex h-full flex-col justify-between">
        <blockquote class="mt-6 border-l-2 pl-6 italic">
          “Cualquier cosa que un hombre pueda imaginar, otros hombres pueden
          hacerla realidad.”
        </blockquote>
        <p class="mt-2 text-xs">- Jules Verne</p>
      </div>
    </Card>
    <ProjectsCard />
    <StudyCard />
  </main>
</BaseLayout>
