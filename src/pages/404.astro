---
import BaseLayout from '../layouts/BaseLayout.astro'
import { buttonVariants } from '../components/ui/button'
---

<BaseLayout
  title="404 — Página no encontrada"
  description="Error 404: esta página no existe o ha cambiado de dirección."
>
  <main
    class="flex min-h-[70vh] w-full flex-auto flex-col items-center justify-center px-8 text-center"
  >
    <img
      src="/me_hello.png"
      alt=""
      width="256"
      height="256"
      class="mb-8 size-64"
      loading="lazy"
      decoding="async"
    />
    <p class="text-sm font-semibold text-primary">404</p>
    <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl">
      Página no encontrada
    </h1>
    <p class="mt-4 max-w-md text-muted-foreground">
      Lo sentimos, no pudimos encontrar la página que estás buscando.
    </p>
    <a href="/" rel="noreferrer" class={`mt-6 ${buttonVariants()}`}>
      Volver al inicio
    </a>
  </main>
</BaseLayout>
