---
import BaseLayout from '../layouts/BaseLayout.astro'
import TopLayout from '../layouts/TopLayout.astro'
import BottomLayout from '../layouts/BottomLayout.astro'
import { EDUCATION, EXPERIENCE, LANGUAGES, SKILL_GROUPS } from '../lib/cv'
import { SITE } from '../lib/site'
---

<BaseLayout
  title={`Experiencia y educación — ${SITE.NAME}`}
  description={`Trayectoria profesional, estudios e idiomas de ${SITE.DISPLAY_NAME}, desarrollador full stack.`}
  breadcrumbs={[
    { name: 'Inicio', href: '/' },
    { name: 'Experiencia', href: '/work' },
  ]}
>
  <main class="flex min-h-[80vh] flex-auto flex-col" transition:animate="fade">
    <TopLayout>
      <h1
        class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Experiencia Laboral
      </h1>
    </TopLayout>
    <BottomLayout>
      <ol class="flex flex-col">
        {
          EXPERIENCE.map((entry) => (
            <li class="animate mt-4 border-b border-black/10 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
              <p class="mb-2 text-sm uppercase text-muted-foreground">
                {entry.start} — {entry.end}
              </p>
              <h2 class="text-lg font-semibold">
                <a
                  href={entry.link}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="text-primary underline underline-offset-4"
                >
                  {entry.company}
                </a>
              </h2>
              <p class="text-sm font-medium">{entry.position}</p>
              <ul class="mt-2 list-disc pl-5 text-sm text-muted-foreground">
                {entry.tasks.map((task) => (
                  <li>{task}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </BottomLayout>

    <TopLayout>
      <h2
        class="mt-10 scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Educación
      </h2>
    </TopLayout>
    <BottomLayout>
      <ul>
        {
          EDUCATION.map((entry) => (
            <li class="animate mt-4 border-b border-black/10 py-4 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
              <h3 class="text-sm font-semibold">{entry.title}</h3>
              <p class="text-sm">{entry.institution}</p>
              <p class="text-sm text-muted-foreground">{entry.duration}</p>
            </li>
          ))
        }
      </ul>
    </BottomLayout>

    <TopLayout>
      <h2
        class="mt-10 scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Idiomas
      </h2>
    </TopLayout>
    <BottomLayout>
      <ul>
        {
          LANGUAGES.map((lang) => (
            <li class="animate mt-4 border-b border-black/10 py-2 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none dark:border-white/25">
              <h3 class="text-sm font-semibold">{lang.language}</h3>
              <p class="text-sm text-muted-foreground">{lang.level}</p>
            </li>
          ))
        }
      </ul>
    </BottomLayout>

    <TopLayout>
      <h2
        class="mt-10 scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0"
      >
        Habilidades Técnicas
      </h2>
    </TopLayout>
    <BottomLayout>
      <dl class="flex flex-col gap-4">
        {
          SKILL_GROUPS.map((group) => (
            <div>
              <dt class="text-sm font-semibold">{group.label}</dt>
              <dd class="mt-1 flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class="rounded-full border px-3 py-1 text-xs">
                    {skill}
                  </span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </BottomLayout>
  </main>
</BaseLayout>
